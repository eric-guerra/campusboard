{
    "name": "ericguerra/campusboard",
    "description": "Student classifieds board: PHP + MySQL + jQuery",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "CampusBoard\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "CampusBoard\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit tests",
        "serve": "php -S localhost:8000 -t public"
    }
}
